# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc
*.tsbuildinfo
*.tsbuildinfo.client
.expo
.expo-shared

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# Runtime cache of the Sleeper player -> team map (see src/lib/teams.ts).
# Regenerated on demand; not source.
artifacts/api-server/data/player-teams.json

# Replit
.cache/
.local/

# The news archive lives in Postgres (see artifacts/api-server/src/lib/db.ts).
# The old SQLite file is kept locally only as the source for
# scripts/import-sqlite-archive.mjs; committing it churned megabytes of binary
# WAL on every publish and could restore a stale snapshot over live data.
artifacts/api-server/data/*.db
artifacts/api-server/data/*.db-shm
artifacts/api-server/data/*.db-wal

# Claude Code user auth/state, kept on the persistent workspace disk
# (/home/runner is an ephemeral overlay). Never commit: contains OAuth tokens.
.claude-home/
