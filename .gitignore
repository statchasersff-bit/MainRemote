# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc
*.tsbuildinfo
*.tsbuildinfo.client
.expo
.expo-shared

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# Runtime caches built from the Sleeper player dictionary (see
# src/lib/teams.ts and src/lib/team/roster.ts). Regenerated on demand; not
# source, and the roster index is ~600KB of churn per refresh.
artifacts/api-server/data/player-teams.json
artifacts/api-server/data/team-roster.json

# Replit
.cache/
.local/

# The news archive lives in Postgres (see artifacts/api-server/src/lib/db.ts).
# The old SQLite file is kept locally only as the source for
# scripts/import-sqlite-archive.mjs; committing it churned megabytes of binary
# WAL on every publish and could restore a stale snapshot over live data.
artifacts/api-server/data/*.db
artifacts/api-server/data/*.db-shm
artifacts/api-server/data/*.db-wal

# Claude Code user auth/state, kept on the persistent workspace disk
# (/home/runner is an ephemeral overlay). Never commit: contains OAuth tokens.
.claude-home/

# esbuild scratch from tests/helpers/bundle.mjs. Cleaned by the test that made
# it; ignored so a crashed run cannot leave one staged.
artifacts/api-server/.test-bundle-*/

# The 2026 outlook workflow's working directory: ~1000 per-player input/output
# files that scripts/player/outlookPrep.js regenerates and outlookMerge.js folds
# into data/player/fantasy_outlook_2026.json. Intermediates, not data.
artifacts/api-server/data/player/.outlook_parts/

# Detached dev-server log from scripts/dev-restart.sh, which restarts whatever
# serves the Replit preview after a src/ edit. Runtime output, not source.
artifacts/api-server/dev-server.log

# Lock file guarding scripts/dev-restart.sh against overlapping runs.
artifacts/api-server/.dev-restart.lock

# Share images, drawn on first request from the stored box scores (og-image.ts).
# Derived, and redrawn when deleted, so never committed.
artifacts/api-server/data/og/
# Written by the production refresh (find-game-videos.mjs --live).
artifacts/api-server/data/matchup/game-videos-live.json
artifacts/api-server/data/matchup/game-videos-live-misses.json
